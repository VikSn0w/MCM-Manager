# Copy to .env and fill in. Never commit .env — it is gitignored.

# --- Database (PostgreSQL) ---
# DATABASE_URL goes through the connection pooler; DIRECT_URL is used for migrations.
DATABASE_URL="postgresql://user:password@host:5432/dbname?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/dbname"

# --- Sessions ---
# REQUIRED. The app refuses to start without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# --- Email (Resend) ---
# Without RESEND_API_KEY the app logs emails to the console instead of sending.
RESEND_API_KEY=""
# Must be an address on a domain verified in Resend. The default sandbox sender
# (onboarding@resend.dev) only delivers to the Resend account owner.
MAIL_FROM="pass@your-verified-domain.com"
# Where back-office notifications go if no ADMIN account exists. Defaults to the
# owner address in email.server.ts; set this once you have a shared inbox.
FALLBACK_ADMIN_EMAIL=""

# --- Branding ---
THEME_PRIMARY="#f97316"
THEME_PRIMARY_HOVER="#ea580c"
THEME_PRIMARY_LIGHT="#fb923c"
THEME_PRIMARY_DARK="#9a3412"
