{
  "name": "MCMManager",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "postinstall": "prisma generate",
    "seed": "npx tsx prisma/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@react-router/node": "7.18.2",
    "@react-router/serve": "7.18.2",
    "bcryptjs": "^3.0.3",
    "impeccable": "^4.1.0",
    "isbot": "^5",
    "lucide-react": "^1.17.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router": "7.18.2",
    "resend": "^6.12.4"
  },
  "devDependencies": {
    "@react-router/dev": "7.18.2",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "prisma": "^5.22.0",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "prisma@5.22.0": true,
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
